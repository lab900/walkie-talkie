index 0000000..96ec150
--- /dev/null
+++ b/Tests/WalkieTalkieTests/WisprStopHeardTests.swift
@@ -0,0 +1,130 @@
+import XCTest
+@testable import WalkieTalkie
+
+/// TE15/TE16 (exploratory run, 2026-09-29): the relay's stop chord posted under
+/// Secure Input or the lock screen never reached Wispr — its microphone stayed
+/// open 60–70 s, its row NULL, and the relay waited out the 30 s capture timeout
+/// before the local model stood in. `WisprState.stopAnswerDue` on a fake clock.
+final class WisprStopHeardTests: XCTestCase {
+    private var clock: CFAbsoluteTime = 500
+    private lazy var m = WisprState(now: { self.clock })
+
+    private func listening() {
+        m.startChord("relay"); clock += 0.15
+        m.sawRow(9, status: "")                      // the row at the gesture, NULL
+        clock += 0.2; m.poll(true)
+        XCTAssertEqual(m.phase, .listening)
+        clock += 8
+    }
+
+    /// Keys blind at the stop (Secure Input, the lock screen) → unheard, at once.
+    func testABlindStopIsUnansweredAtOnce() {
+        listening()
+        m.stopPosted(blind: "Secure Input is on (the session names TextEdit)")
+        m.stopChord("the relay's own stop gesture")
+        guard case .unanswered(let why) = m.stopAnswerDue(wisprMicOpen: true, rowDuration: nil, wisprFrozen: false) else {
+            return XCTFail("a blind stop must be unanswered at once")
+        }
+        XCTAssertTrue(why.contains("Secure Input"), why)
+    }
+
+    /// Keys visible, Wispr's microphone still open, the row unmoved: pending
+    /// until the 2 s grace, unanswered from it on.
+    func testAMicStillOpenTwoSecondsOnIsUnanswered() {
+        listening()
+        m.stopPosted(blind: nil); m.stopChord("stop")
+        let at = clock
+        XCTAssertEqual(m.stopAnswerDue(wisprMicOpen: true, rowDuration: nil, wisprFrozen: false),
+                       .pending(until: at + WisprState.stopAnswerGrace))
+        clock += WisprState.stopAnswerGrace - 0.01
+        XCTAssertEqual(m.stopAnswerDue(wisprMicOpen: true, rowDuration: nil, wisprFrozen: false),
+                       .pending(until: at + WisprState.stopAnswerGrace))
+        clock += 0.01
+        guard case .unanswered = m.stopAnswerDue(wisprMicOpen: true, rowDuration: nil, wisprFrozen: false) else {
+            return XCTFail("still open with the row unmoved 2 s after the stop")
+        }
+    }
+
+    /// The healthy stop: the row goes `processing` (or its `duration` is written),
+    /// or the microphone closes → answered, whatever the clock says.
+    func testARowThatMovesOrAMicThatClosesIsAnswered() {
+        listening()
+        m.stopPosted(blind: nil); m.stopChord("stop")
+        clock += 0.1; m.sawRow(9, status: "processing")
+        clock += 5
+        guard case .answered = m.stopAnswerDue(wisprMicOpen: true, rowDuration: nil, wisprFrozen: false) else {
+            return XCTFail("a row that moved after the stop is an answer")
+        }
+        listening()
+        m.stopPosted(blind: nil); m.stopChord("stop")
+        clock += 5
+        guard case .answered = m.stopAnswerDue(wisprMicOpen: true, rowDuration: 8.4, wisprFrozen: false) else {
+            return XCTFail("a duration written is Wispr's stop path having run")
+        }
+        guard case .answered = m.stopAnswerDue(wisprMicOpen: false, rowDuration: nil, wisprFrozen: false) else {
+            return XCTFail("a closed microphone is an answer")
+        }
+    }
+
+    /// A frozen Wispr (SIGSTOP; TE27/TE28) is not an unheard chord: the p95 wait
+    /// and `Use local` answer it, not a dismiss.
+    func testAFrozenWisprIsNotAnUnheardStop() {
+        listening()
+        m.stopPosted(blind: nil); m.stopChord("stop")
+        clock += 5
+        guard case .answered(let why) = m.stopAnswerDue(wisprMicOpen: true, rowDuration: nil, wisprFrozen: true) else {
+            return XCTFail("frozen is not unheard")
+        }
+        XCTAssertTrue(why.contains("stopped"), why)
+    }
+
+    /// No stop posted (W6: Wispr never took the start, so no chord went out) →
+    /// nothing to ask; the next chord forgets the last stop.
+    func testNoStopPostedAndTheNextChordForgets() {
+        listening()
+        guard case .answered = m.stopAnswerDue(wisprMicOpen: true, rowDuration: nil, wisprFrozen: false) else {
+            return XCTFail("no stop posted")
+        }
+        m.stopPosted(blind: "the screen is locked")
+        listening()                                   // a new chord
+        guard case .answered = m.stopAnswerDue(wisprMicOpen: true, rowDuration: nil, wisprFrozen: false) else {
+            return XCTFail("the new sentence has no stop yet")
+        }
+    }
+
+    /// The route runs the same machine: `stop-posted` / `stop-due` → `stopVerdicts`.
+    func testTheSimulateRouteAnswersTheVerdicts() {
+        let out = WisprStateSimulation.run([
+            ["input": "chord", "atMs": 0],
+            ["input": "row", "status": "", "atMs": 150],
+            ["input": "stop-posted", "atMs": 9000],
+            ["input": "stop", "atMs": 9000],
+            ["input": "stop-due", "micOpen": true, "atMs": 9500],
+            ["input": "stop-due", "micOpen": true, "atMs": 11_000],
+            ["input": "stop-posted", "blind": "the screen is locked", "atMs": 12_000],
+            ["input": "stop-due", "micOpen": true, "atMs": 12_000],
+        ])
+        let v = (out["stopVerdicts"] as? [[String: Any]])?.map { $0["verdict"] as? String }
+        XCTAssertEqual(v, ["pending", "unanswered", "unanswered"])
+    }
+}
+
+/// The ghost watch (E) after an unheard stop words it as the relay's own sentence.
+final class GhostAfterStopTests: XCTestCase {
+    func testTheAfterStopWordingAndTheSameGuards() {
+        let why = WisprOwnership.ghostMic(now: 1_010, micOpen: true, relayRecording: false, unansweredAt: 1_000,
+                                          hisKeysHeld: false, hisChordAt: 0, window: 90, relayChordAt: 990,
+                                          relayCaptureInFlight: false, afterStop: true)
+        XCTAssertNotNil(why)
+        XCTAssertTrue(why?.contains("stop it never heard") == true, why ?? "")
+        // His push-to-talk held, or a relay chord since: not ours to dismiss.
+        XCTAssertNil(WisprOwnership.ghostMic(now: 1_010, micOpen: true, relayRecording: false, unansweredAt: 1_000,
+                                             hisKeysHeld: true, hisChordAt: 0, window: 90, afterStop: true))
+        XCTAssertNil(WisprOwnership.ghostMic(now: 1_010, micOpen: true, relayRecording: false, unansweredAt: 1_000,
+                                             hisKeysHeld: false, hisChordAt: 0, window: 90, relayChordAt: 1_005,
+                                             afterStop: true))
+        // 90 s window after a stop (the lock screen's minute), 25 s after a start.
+        XCTAssertNotNil(WisprOwnership.ghostMic(now: 1_060, micOpen: true, relayRecording: false, unansweredAt: 1_000,
+                                                hisKeysHeld: false, hisChordAt: 0, window: 90, afterStop: true))
+    }
+}
